#pragma once

// -----------------------------------------------------------------------------
//  WI-FI  (somente redes 2.4 GHz - o ESP32-S3 nao suporta 5 GHz)
// -----------------------------------------------------------------------------
#define WIFI_SSID               "NOME_DA_SUA_REDE"
#define WIFI_PASSWORD           "SENHA_DA_SUA_REDE"

// -----------------------------------------------------------------------------
//  GROQ - Speech to Text (Whisper large v3)
//  Onde pegar: https://console.groq.com/keys
//  Formato:    gsk_...
// -----------------------------------------------------------------------------
#define GROQ_API_KEY            "gsk_COLE_SUA_CHAVE_GROQ_AQUI"

// -----------------------------------------------------------------------------
//  GOOGLE GEMINI - LLM
//  Onde pegar: https://aistudio.google.com/app/apikey
//  Formato:    AIza... ou AQ.... (o AI Studio emite os dois)
// -----------------------------------------------------------------------------
#define GEMINI_API_KEY          "AIza_COLE_SUA_CHAVE_GEMINI_AQUI"

// -----------------------------------------------------------------------------
//  ELEVENLABS - Text to Speech  (usado quando TTS_PROVIDER = ELEVENLABS)
//  Chave:  https://elevenlabs.io  ->  Perfil  ->  API Keys      (formato sk_...)
//  Voz:    https://elevenlabs.io  ->  Voices  ->  ID da voz
//          "21m00Tcm4TlvDq8ikWAM" = Rachel (voz padrao, funciona em PT-BR)
// -----------------------------------------------------------------------------
#define ELEVENLABS_API_KEY      "sk_COLE_SUA_CHAVE_ELEVENLABS_AQUI"
#define ELEVENLABS_VOICE_ID     "21m00Tcm4TlvDq8ikWAM"

// -----------------------------------------------------------------------------
//  GOOGLE CLOUD TTS  (alternativa - usado quando TTS_PROVIDER = GOOGLE)
//  Habilite a "Cloud Text-to-Speech API" no Google Cloud e gere uma API key.
//  Pode ser a mesma chave do Gemini se o projeto tiver as duas APIs ativas.
// -----------------------------------------------------------------------------
#define GOOGLE_TTS_API_KEY      "AIza_COLE_SUA_CHAVE_GOOGLE_TTS_AQUI"
